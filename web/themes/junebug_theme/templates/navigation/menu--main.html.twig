{% import _self as menus %}

<nav class="nav shadow" aria-label="Main navigation">
  <a class="nav__brand parkinsans-extra-bold" href="{{ path('<front>') }}">Junebug</a>
  {{ menus.menu_links(items, attributes, 0) }}
</nav>

{% macro menu_links(items, attributes, menu_level) %}
  {% import _self as menus %}

  {% if items %}
    {% if menu_level == 0 %}
      <ul{{ attributes.addClass('nav__menu', 'parkinsans-bold') }}>
    {% else %}
      <ul class="nav__submenu">
    {% endif %}

    {% for item in items %}
      {% set item_classes = [
        'nav__item',
        item.is_expanded ? 'nav__item--expanded',
        item.is_collapsed ? 'nav__item--collapsed',
        item.in_active_trail ? 'nav__item--active-trail',
      ] %}
      <li{{ item.attributes.addClass(item_classes) }}>
        {{ link(item.title, item.url, {class: ['nav__link']}) }}
        {% if item.below %}
          {{ menus.menu_links(item.below, attributes, menu_level + 1) }}
        {% endif %}
      </li>
    {% endfor %}
    </ul>
  {% endif %}
{% endmacro %}
