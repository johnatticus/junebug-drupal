<div class="site-shell">
  {{ page.messages }}

  <header class="site-header">
    <div class="content-width site-header__inner">
      {{ page.header }}

      {% if page.primary_menu %}
        <div class="site-header__primary">
          {{ page.primary_menu }}
        </div>
      {% endif %}
    </div>
  </header>

  {% if page.featured %}
    <section class="content-width featured-region">
      {{ page.featured }}
    </section>
  {% endif %}

  <main class="content-width page-layout">
    <div id="main-content" class="main-content">
      {% block main_content %}
        {{ page.content }}
      {% endblock %}
    </div>
  </main>

  <footer class="content-width site-footer">
    {{ page.footer }}
  </footer>
</div>
