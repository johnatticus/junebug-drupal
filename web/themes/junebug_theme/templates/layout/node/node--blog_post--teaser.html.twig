<article{{ attributes.addClass('container-color', 'container-headline', 'shadow', 'green', 'node-card') }}>
  <div class="node-card__icon">
    <img src="{{ base_path ~ directory ~ '/images/post.svg' }}" alt="" class="post-type-icon" />
  </div>

  <div class="node-card__body">
    {{ title_prefix }}
    <h2{{ title_attributes.addClass('parkinsans-bold', 'node-card__title') }}>
      <a href="{{ url }}">{{ label }}</a>
    </h2>
    {{ title_suffix }}

    <p class="node-card__meta">
      posted by
      <strong class="node-card__author">{{ author_name }}</strong>
      <span class="muted">on {{ date }}</span>
    </p>

    <div{{ content_attributes.addClass('node-card__excerpt') }}>
      {% if content.field_excerpt %}
        {{ content.field_excerpt }}
      {% else %}
        {{ content.body }}
      {% endif %}
    </div>

    <div class="node-card__read-more">
      <a class="parkinsans-bold" href="{{ url }}">Read more →</a>
    </div>
  </div>

  <div class="node-card__actions">
    <button class="icon-btn" aria-label="Like">
      <img src="{{ base_path ~ directory ~ '/images/like.svg' }}" alt="" />
    </button>
    <span class="count badge">0</span>

    <button class="icon-btn" aria-label="Comments">
      <img src="{{ base_path ~ directory ~ '/images/comment.svg' }}" alt="" />
    </button>
    <span class="count badge">0</span>
  </div>
</article>
