{% extends "@junebug_theme/layout/page.html.twig" %}

{% block main_content %}
  <section class="about" aria-labelledby="about-title">
    <div class="about__portrait">
      <img
        class="shadow-small about__image"
        src="{{ base_path ~ directory ~ '/images/me.jpeg' }}"
        alt="Nora"
        width="200"
        height="352"
      />
    </div>

    <div class="about__content">
      <div class="container-color shadow yellow about__intro">
        <h1 id="about-title" class="parkinsans-bold">My name is Nora. My grandpa calls me Junebug.</h1>
        <p>I'm 2 and do a lot of things. I love critters, bugs, nature...all that stuff. I live near an airport, so I watch planes come and go. It never gets old.</p>
        <p>My dad made me this website. I don't know how it works, but I think Dad does.</p>
      </div>

      <div class="about__cards">
        <section class="container-color shadow yellow about__card">
          <h2 class="parkinsans-bold">I like:</h2>
          <ul class="parkinsans-regular about-ul">
            <li>🐄 Farm animals</li>
            <li>🕶️ Sunglasses</li>
            <li>🕷️ Spiders</li>
            <li>🥦 Green beans</li>
            <li>🎠 Swing sets and Carousels</li>
          </ul>
        </section>

        <section class="container-color shadow yellow about__card">
          <h2 class="parkinsans-bold">My favorite:</h2>
          <ul class="parkinsans-regular about-ul">
            <li>Color? Purple 💜</li>
            <li>Fruit? Banana 🍌</li>
            <li>Drink? Apple Juice 🧃</li>
            <li>Book? Goodnight Goon 👹</li>
            <li>Toy? Mango 🐈</li>
          </ul>
        </section>
      </div>
    </div>
  </section>
{% endblock %}
