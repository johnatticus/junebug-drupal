{% extends "@junebug_theme/layout/page.html.twig" %}

{% block main_content %}
  <section class="blog-page" aria-labelledby="blog-title">
    <header class="container-color green shadow blog-page__header">
      <h1 id="blog-title" class="parkinsans-extra-bold headline">Blog</h1>
      <p>Latest posts, updates, and assorted Junebug chaos.</p>
    </header>

    <div class="blog-page__content">
      {{ page.content }}
    </div>
  </section>
{% endblock %}
