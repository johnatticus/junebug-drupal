<?php

declare(strict_types=1);

use Drupal\Component\Render\MarkupInterface;
use Drupal\Component\Serialization\Json;
use Drupal\Core\Form\FormStateInterface;
use Drupal\Core\Url;

/**
 * @file
 * Functions to support theming in the junebug_theme theme.
 */

/**
 * Implements hook_preprocess_HOOK() for html.html.twig.
 */
function junebug_theme_preprocess_html(array &$variables): void {

}

/**
 * Implements hook_preprocess_HOOK() for page.html.twig.
 */
function junebug_theme_preprocess_page(array &$variables): void {
  if (empty($variables['node']) || !$variables['node'] instanceof \Drupal\node\NodeInterface) {
    return;
  }

  $node = $variables['node'];
  if (_junebug_theme_current_alias() !== 'about' || !$node->hasField('field_about_heading')) {
    return;
  }

  $variables['about_heading'] = $node->get('field_about_heading')->value;
  $variables['about_portrait'] = $node->get('field_about_portrait')->view([
    'label' => 'hidden',
    'type' => 'image',
    'settings' => [
      'image_link' => '',
      'image_style' => '',
      'image_loading' => [
        'attribute' => 'eager',
      ],
    ],
  ]);
  $variables['about_intro'] = $node->get('field_about_intro')->view([
    'label' => 'hidden',
    'type' => 'text_default',
  ]);
  $variables['about_likes'] = array_column($node->get('field_about_likes')->getValue(), 'value');
  $variables['about_favorites'] = array_column($node->get('field_about_favorites')->getValue(), 'value');

}

/**
 * Implements hook_preprocess_HOOK() for menu.html.twig.
 */
function junebug_theme_preprocess_menu(array &$variables): void {
  if (($variables['menu_name'] ?? '') !== 'main') {
    return;
  }

  $account = \Drupal::currentUser();
  $destination = \Drupal::request()->getPathInfo();
  $items = [];
  $cache_contexts = [
    'url.path',
    'user.roles:anonymous',
  ];

  if ($account->isAnonymous()) {
    $items[] = _junebug_theme_account_link(
      t('Signup'),
      Url::fromRoute('user.register'),
      TRUE,
    );
    $items[] = _junebug_theme_account_link(
      t('Login'),
      Url::fromRoute('user.login', [], ['query' => ['destination' => $destination]]),
      TRUE,
    );
  }
  else {
    $items[] = _junebug_theme_account_link(
      t('My account'),
      Url::fromRoute('user.page'),
    );
    $items[] = _junebug_theme_account_link(t('Logout'), Url::fromRoute('user.logout'));
    $cache_contexts[] = 'user';
  }

  $account_menu = [
    '#theme' => 'item_list',
    '#items' => $items,
    '#attributes' => [
      'class' => ['nav__account-menu', 'parkinsans-bold'],
      'aria-label' => t('Account'),
    ],
    '#cache' => [
      'contexts' => $cache_contexts,
    ],
  ];

  if ($account->isAnonymous()) {
    $account_menu['#attached']['library'][] = 'core/drupal.dialog.ajax';
  }

  $variables['junebug_account_menu'] = $account_menu;
}

/**
 * Implements hook_form_FORM_ID_alter() for user_login_form.
 */
function junebug_theme_form_user_login_form_alter(array &$form, FormStateInterface $form_state, string $form_id): void {
  $form['#attributes']['class'][] = 'junebug-auth-form';
  $form['forgot_password'] = [
    '#type' => 'link',
    '#title' => t('Forgot your password?'),
    '#url' => Url::fromRoute('user.pass'),
    '#weight' => 100,
    '#attributes' => _junebug_theme_dialog_attributes(['auth-form__secondary-link']),
  ];
}

/**
 * Implements hook_form_FORM_ID_alter() for user_register_form.
 */
function junebug_theme_form_user_register_form_alter(array &$form, FormStateInterface $form_state, string $form_id): void {
  $form['#attributes']['class'][] = 'junebug-auth-form';
  $form['account_help'] = [
    '#type' => 'container',
    '#weight' => -100,
    '#attributes' => ['class' => ['auth-form__intro']],
    'text' => [
      '#markup' => '<p>' . t('Request an account for access to the private family blog. After an administrator approves it, you will receive email instructions to set your password.') . '</p>',
    ],
  ];

  // Personal contact forms are not part of the member signup experience.
  unset($form['contact']);
}

/**
 * Implements hook_form_FORM_ID_alter() for user_pass.
 */
function junebug_theme_form_user_pass_alter(array &$form, FormStateInterface $form_state, string $form_id): void {
  $form['#attributes']['class'][] = 'junebug-auth-form';
}

/**
 * Implements hook_preprocess_HOOK() for node.html.twig.
 */
function junebug_theme_preprocess_node(array &$variables): void {
  if ($variables['view_mode'] === 'teaser' && $variables['node']->bundle() === 'blog_post') {
    // Author display name
    $account = $variables['node']->getOwner();
    $variables['author_name'] = $account ? $account->getDisplayName() : 'Anonymous';

    // Date (e.g., Sep 25, 2025) — adjust to taste
    $variables['date'] = \Drupal::service('date.formatter')
      ->format($variables['elements']['#node']->getCreatedTime(), 'custom', 'M j, Y');
  }
}

/**
 * Helper: return the current path alias without leading slash.
 */
function _junebug_theme_current_alias(): string {
  $current_path = \Drupal::service('path.current')->getPath();
  $alias = \Drupal::service('path_alias.manager')->getAliasByPath($current_path);
  return trim($alias, '/');
}

/**
 * Builds a navigation link for an account action.
 */
function _junebug_theme_account_link(string|MarkupInterface $title, Url $url, bool $dialog = FALSE): array {
  $attributes = ['class' => ['nav__link']];
  if ($dialog) {
    $attributes = _junebug_theme_dialog_attributes(['nav__link', 'auth-dialog__trigger']);
  }

  return [
    '#type' => 'link',
    '#title' => $title,
    '#url' => $url,
    '#attributes' => $attributes,
  ];
}

/**
 * Returns attributes that load a route in Drupal's core modal dialog.
 */
function _junebug_theme_dialog_attributes(array $classes = []): array {
  return [
    'class' => array_merge(['use-ajax'], $classes),
    'data-dialog-type' => 'modal',
    'data-dialog-options' => Json::encode([
      'classes' => ['ui-dialog' => 'junebug-auth-dialog'],
      'width' => 'min(42rem, calc(100vw - 2rem))',
    ]),
    'aria-haspopup' => 'dialog',
  ];
}

/**
 * Adds page template suggestions based on the current path alias.
 */
function junebug_theme_theme_suggestions_page_alter(array &$suggestions, array &$variables): void {
  $alias = _junebug_theme_current_alias();
  if ($alias === '' || $alias === 'admin' || str_starts_with($alias, 'admin/') || str_starts_with($alias, 'node/')) {
    return;
  }
  $sanitized = strtr($alias, ['/' => '__', '-' => '_']);
  $candidate = 'page__' . $sanitized;
  if (!in_array($candidate, $suggestions, true)) {
    $suggestions[] = $candidate;
  }
}
